[{{ sftp_mount_name }}]
type = sftp
host = {{ sftp_host }}
user =   {{ sftp_user }}
port = {{ sftp_port }}
key_file = {{ sftp_key }}
md5sum_command = md5 -r
sha1sum_command = sha1 -r
shell_type = unix

[{{ crypt_mount_name }}]
type = crypt
remote = {{ sftp_mount_name }}:crypt
filename_encryption = standard
directory_name_encryption = true
password = {{ crypt_password }}